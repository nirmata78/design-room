# ── Private: your rounds, scores and profile never leave this machine ──
profile.md
Progress-Log.md
interview.md
.clock.json
board/
private/
sessions/*
!sessions/README.md

# ── Jekyll / GitHub Pages local builds ──
_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata
Gemfile.lock

# ── OS / editor ──
.DS_Store
.obsidian/
.idea/
.vscode/
*.swp

# ── Rendered PDFs: every one is rebuilt from tracked sources (reports, booklets, slide decks) ──
*.pdf
.report.html
!examples/*.pdf

# ── PDF kit: local venv, build intermediates, review images ──
pdf-kit/.venv/
*.built.html
*_pages/

# ── Mock-interview videos: rebuildable, too large for the repo ──
# Sources stay tracked (script.md, video-slides.html, *.css, diagrams.py, svg/, build-video.sh);
# everything build-video.sh produces is ignored.
**/video/frames/
**/video/audio/
**/video/.v[0-9]*/
**/video/.*.v[0-9]*.md
*.mp4
*.m4a
*.mov
*.webm
*.wav
*.mp3

# ── Python ──
__pycache__/
*.pyc
