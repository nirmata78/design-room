# ── Private: your rounds, scores and profile never leave this machine ──
profile.md
Progress-Log.md
interview.md
.clock.json
.scenario.json
board/
private/
sessions/*
!sessions/README.md

# ── Jekyll / GitHub Pages local builds ──
_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata
Gemfile.lock

# ── OS / editor ──
.DS_Store
.obsidian/
.idea/
.vscode/
*.swp

# ── Rendered PDFs: every one is rebuilt from tracked sources (reports, booklets, slide decks) ──
*.pdf
.report.html
!examples/*.pdf

# ── PDF kit: local venv, build intermediates, review images ──
pdf-kit/.venv/
*.built.html
*.check.html
**/video/layout-report.txt
*_pages/

# ── Mock-interview videos: rebuildable, too large for the repo ──
# Sources stay tracked (script.md, video-slides.html, *.css, diagrams.py, svg/, build-video.sh);
# everything build-video.sh produces is ignored.
**/video/frames/
**/video/audio/
**/video/.v[0-9]*/
**/video/.*.v[0-9]*.md
# sidecar captions written beside a reference-solution MP4 (build_video.py --captions sidecar); upload, don't commit
**/video/*.srt
**/video/*.vtt
*.mp4
# Course builder output (theory/video/course.py): MP4s, slide PDFs, chapter files; inside the repo, never ~/Movies
theory/**/out/
solutions/**/out/
*.m4a
*.mov
*.webm
*.wav
*.mp3

# ── Python ──
__pycache__/
*.pyc

# ── Third-party reference videos: private study copies; only our own notes (README/ANALYSIS) are tracked ──
references/video-examples/**/original.mp4
references/video-examples/**/frames/
references/video-examples/**/sheet_*.jpg
references/video-examples/**/meta.info.json
references/video-examples/**/subs.*
references/video-examples/**/transcript*

# ── Claude Code: project skills are tracked; local settings and locks are not ──
.claude/*
!.claude/skills/

# Build logs carry local paths
build.log
