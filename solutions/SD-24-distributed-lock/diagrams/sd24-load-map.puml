@startuml
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam rectangle {
  BackgroundColor #e8f0fa
  BorderColor #2f6fb5
}
rectangle "Clients\n(about 400 processes)\n30,000 attempts/s at peak" as C
rectangle "Gateways\nstateless: auth, quota, route\nanswers failed try-once from\nthe leader's memory" as G
rectangle "Group 1\n~7,500 writes/s" as G1 #fdecea
rectangle "Group 2\n~7,500 writes/s" as G2 #fdecea
rectangle "Group 3\n~7,500 writes/s" as G3 #fdecea
rectangle "Group 4\n~7,500 writes/s" as G4 #fdecea
rectangle "Heartbeats\n~120/s, not log entries" as H #e7f4ec
C --> G : 30,000/s
G --> G1 : hash(name)
G --> G2
G --> G3
G --> G4
C ..> H : sessions
note bottom of G1 : ceiling about 15,000 writes/s a group\nred = must be strictly correct
@enduml
